{
  "name": "lintas-benteng-projection",
  "private": true,
  "type": "module",
  "description": "Alat uji dan terbit. Situs sendiri tidak memakai build; SDK Firebase sudah disimpan di site/vendor/firebase.",
  "scripts": {
    "test": "node --test tests_js/*.test.mjs",
    "uji:aturan": "firebase emulators:exec --only firestore --project demo-lbp \"node --test tests_firebase/*.test.mjs\"",
    "emulator": "firebase emulators:start --only auth,firestore --project demo-lbp"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.27.0"
  }
}
