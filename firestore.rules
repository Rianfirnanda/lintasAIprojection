rules_version = '2';

// Aturan Firestore untuk Lintas Benteng Projection.
//
// Semua koleksi berawalan "lbp_" supaya tidak bercampur dengan koleksi aplikasi lain di proyek Firebase
// yang sama (proyek "lintas benteng"). PENTING: aturan Firestore hanya ada satu per database. Kalau aplikasi lain
// di proyek ini sudah punya aturan, gabungkan blok "match /lbp_..." di bawah ke aturan itu, jangan ditimpa.
//
// Alur akun:
//   1. Orang masuk dengan Google, lalu membuat dokumen lbp_pengguna/{uid} miliknya sendiri berstatus "menunggu",
//      tanpa peran dan tanpa izin halaman.
//   2. Pengelola akun menyetujui (status "aktif" + peran + izin halaman), menolak, atau menonaktifkan akun.
//      Pengelola akun = akun aktif yang boleh membuka halaman Pengguna: peran Administrator, atau orang yang diberi
//      halaman itu lewat izin pribadi atau tabel hak akses. Mengangkat atau mencopot admin (peran Administrator atau
//      halaman Pengaturan/Pengguna) dan mengubah tabel hak akses tetap hanya untuk peran Administrator.
//   3. Admin pertama: email yang terdaftar di daftarAdminAwal() boleh mengangkat dirinya sendiri menjadi admin.
//      Daftar ini diisi otomatis saat terbit dari GitHub Secret FIREBASE_ADMIN_AWAL, bukan ditulis di repositori.
//
// Pekerjaan harian juga lewat situs: harga dari petugas, keputusan cek data, tindak lanjut peringatan, persetujuan
// model, pengaturan, kunci rahasia, dan permintaan "jalankan". Mesin pengolah (GitHub Actions dengan akun layanan)
// mengambilnya dari koleksi di bawah. Akun layanan tidak terikat aturan ini, jadi koleksi yang hanya untuk mesin
// (lbp_rahasia, lbp_status) cukup ditutup bagi browser.

service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() { return request.auth != null; }
    function akun(uid) { return /databases/$(database)/documents/lbp_pengguna/$(uid); }
    /** Peran Administrator yang aktif (pemilik sistem). */
    function adminAktif() {
      return masuk() && exists(akun(request.auth.uid))
        && get(akun(request.auth.uid)).data.status == 'aktif'
        && get(akun(request.auth.uid)).data.peran == 'admin';
    }
    function jalurAkses() { return /databases/$(database)/documents/lbp_akses/peran; }
    /** Tabel hak akses per peran yang diatur admin di halaman Pengguna ({} bila belum pernah diubah). */
    function tabelAkses() { return exists(jalurAkses()) ? get(jalurAkses()).data.halaman : {}; }
    /** Akun yang memegang hak admin: peran Administrator, atau diberi halaman Pengaturan/Pengguna. */
    function hakAdmin(d) {
      return d.get('peran', null) == 'admin'
        || (d.get('halaman', null) is list && d.halaman.hasAny(['pengaturan.html', 'pengguna.html']));
    }
    function daftarAdminAwal() { return /*ADMIN_AWAL*/[]; }
    function adminAwal() {
      return masuk() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in daftarAdminAwal();
    }

    function peranSah(p) { return p in ['masyarakat', 'petugas', 'operator', 'analis', 'tpid', 'admin']; }
    function statusSah(s) { return s in ['menunggu', 'aktif', 'ditolak', 'nonaktif']; }
    function teksPendek(x, maks) { return x is string && x.size() <= maks; }
    function halamanSah(h) { return h == null || (h is list && h.size() <= 30); }
    function tanggalSah(x) { return x is string && x.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Hak membuka halaman: izin halaman yang diatur admin (bila ada), selain itu bawaan peran. Admin selalu boleh.
    // Bawaan peran harus sama dengan menu di site/assets/akses.js.
    // Urutan: izin pribadi akun (bila diatur), lalu tabel hak akses dari halaman Pengguna, lalu bawaan peran.
    function bolehHalaman(h, bawaan) {
      let a = get(akun(request.auth.uid)).data;
      let t = tabelAkses();
      return a.status == 'aktif'
        && (a.peran == 'admin'
            || (a.halaman is list && h in a.halaman)
            || (!(a.halaman is list) && a.peran in t && t[a.peran] is list && h in t[a.peran])
            || (!(a.halaman is list) && !(a.peran in t) && a.peran in bawaan));
    }
    function izin(h, bawaan) { return masuk() && exists(akun(request.auth.uid)) && bolehHalaman(h, bawaan); }
    function aktif() { return masuk() && exists(akun(request.auth.uid)) && get(akun(request.auth.uid)).data.status == 'aktif'; }
    function bolehCatat() { return izin('input.html', ['petugas']); }
    function bolehCekData() { return izin('kualitas.html', ['operator', 'analis']); }
    function bolehTindakLanjut() { return izin('sinyal.html', ['analis', 'tpid']); }
    function bolehSetujuiModel() { return izin('model.html', ['analis']); }
    function kelolaPengguna() { return izin('pengguna.html', []); }
    function kelolaSistem() { return izin('pengaturan.html', []); }
    function baru() { return request.resource.data; }
    function stempel() { return baru().diperbarui == request.time && baru().oleh_uid == request.auth.uid; }

    // Kunci yang boleh diisi lewat situs. Kunci Firebase sendiri tetap di GitHub Secrets (mesin butuh itu untuk masuk).
    function namaRahasiaSah(n) {
      return n in ['GEMINI_API_KEY', 'ANTHROPIC_API_KEY', 'TELEGRAM_BOT_TOKEN', 'TELEGRAM_CHAT_ID', 'SMTP_HOST', 'SMTP_PORT',
                   'SMTP_USER', 'SMTP_PASSWORD', 'EMAIL_KE', 'EMAIL_DARI'];
    }

    function kolomSah(d) {
      return d.keys().hasOnly(['email', 'nama', 'foto', 'status', 'peran', 'halaman', 'dibuat', 'diperbarui',
                               'diputus_oleh', 'diputus_pada', 'catatan']);
    }

    match /lbp_pengguna/{uid} {
      // Pemilik boleh membaca akunnya sendiri; pengelola akun boleh membaca dan mendaftar semua akun.
      allow read: if (masuk() && request.auth.uid == uid) || kelolaPengguna();

      // Pendaftaran: hanya untuk diri sendiri, selalu "menunggu", tanpa peran dan tanpa izin.
      allow create: if masuk() && request.auth.uid == uid
        && kolomSah(request.resource.data)
        && request.resource.data.status == 'menunggu'
        && request.resource.data.peran == null
        && request.resource.data.halaman == null
        && request.resource.data.email == request.auth.token.email
        && teksPendek(request.resource.data.nama, 120)
        && request.resource.data.dibuat == request.time;

      // Admin pertama mengangkat dirinya sendiri (hanya email di daftarAdminAwal()).
      allow create: if adminAwal() && request.auth.uid == uid
        && kolomSah(request.resource.data)
        && request.resource.data.status == 'aktif'
        && request.resource.data.peran == 'admin'
        && request.resource.data.halaman == null
        && request.resource.data.email == request.auth.token.email
        && teksPendek(request.resource.data.nama, 120);
      allow update: if adminAwal() && request.auth.uid == uid
        && request.resource.data.status == 'aktif'
        && request.resource.data.peran == 'admin'
        && request.resource.data.halaman == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'peran', 'halaman', 'diperbarui', 'diputus_oleh', 'diputus_pada']);

      // Pemilik hanya boleh memperbarui nama dan foto, tidak bisa mengubah status, peran, atau izinnya sendiri.
      allow update: if masuk() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'foto', 'diperbarui'])
        && teksPendek(request.resource.data.nama, 120);

      // Pengelola akun mengatur akun orang lain. Tidak ada yang bisa mengubah status, peran, atau izin akunnya sendiri
      // (admin tidak terkunci, dan pengelola tidak bisa menaikkan haknya sendiri). Akun yang memegang atau akan
      // memegang hak admin hanya bisa diatur oleh peran Administrator.
      allow update: if kelolaPengguna()
        && kolomSah(request.resource.data)
        && request.resource.data.email == resource.data.email
        && statusSah(request.resource.data.status)
        && (request.resource.data.peran == null || peranSah(request.resource.data.peran))
        && (request.resource.data.status != 'aktif' || request.resource.data.peran != null)
        && halamanSah(request.resource.data.halaman)
        && (uid != request.auth.uid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'peran', 'halaman']))
        && ((!hakAdmin(resource.data) && !hakAdmin(request.resource.data)) || adminAktif());
      allow delete: if kelolaPengguna() && uid != request.auth.uid && (!hakAdmin(resource.data) || adminAktif());
    }

    // Jejak tindakan admin (siapa menyetujui, mengubah peran, menolak, menghapus). Tidak bisa diubah atau dihapus.
    match /lbp_jejak/{id} {
      allow read: if kelolaPengguna();
      allow create: if kelolaPengguna()
        && request.resource.data.keys().hasOnly(['aksi', 'oleh', 'oleh_email', 'sasaran', 'sasaran_email', 'rincian', 'waktu'])
        && request.resource.data.oleh == request.auth.uid
        && request.resource.data.waktu == request.time
        && teksPendek(request.resource.data.aksi, 40);
    }

    // Tabel hak akses per peran (halaman Pengguna). Semua akun aktif membacanya untuk menyusun menu; hanya peran
    // Administrator yang mengubahnya. Peran Administrator sendiri selalu membuka semua halaman, jadi tidak ada di sini.
    match /lbp_akses/{id} {
      allow read: if aktif();
      allow create, update: if adminAktif() && id == 'peran'
        && baru().keys().hasOnly(['halaman', 'diubah_oleh', 'diubah_pada'])
        && baru().halaman is map
        && baru().halaman.keys().hasOnly(['masyarakat', 'petugas', 'operator', 'analis', 'tpid'])
        && baru().diubah_oleh == request.auth.token.email
        && baru().diubah_pada == request.time;
    }

    // Harga dari petugas (formulir Catat Harga) atau dari berkas yang diunggah operator. ID dokumen = id_klien, jadi
    // kiriman ulang dari HP yang sempat luring tidak menjadi ganda. Tidak bisa diubah: koreksi lewat Cek Data.
    match /lbp_harga/{id} {
      allow read: if (masuk() && resource.data.oleh_uid == request.auth.uid) || bolehCekData();
      allow create: if (bolehCatat() || bolehCekData())
        && baru().keys().hasAll(['tanggal', 'kode_pasar', 'kode_varian', 'harga', 'id_klien', 'petugas', 'diterima', 'diperbarui', 'oleh_uid'])
        && baru().keys().hasOnly(['tanggal', 'kode_pasar', 'kode_varian', 'harga', 'satuan', 'kode_sumber', 'petugas', 'responden',
                                  'id_klien', 'waktu_input', 'catatan', 'berkas', 'oleh_uid', 'oleh_email', 'diterima', 'diperbarui'])
        && tanggalSah(baru().tanggal)
        && teksPendek(baru().kode_pasar, 30) && baru().kode_pasar.size() > 0
        && teksPendek(baru().kode_varian, 30) && baru().kode_varian.size() > 0
        && baru().harga is number && baru().harga > 0 && baru().harga < 100000000
        && teksPendek(baru().get('satuan', ''), 20) && teksPendek(baru().get('kode_sumber', ''), 30)
        && teksPendek(baru().petugas, 60) && teksPendek(baru().get('responden', ''), 60)
        && baru().id_klien == id && id.size() <= 80
        && teksPendek(baru().get('waktu_input', ''), 40) && teksPendek(baru().get('catatan', ''), 300)
        && teksPendek(baru().get('berkas', ''), 160)
        && baru().get('oleh_email', request.auth.token.email) == request.auth.token.email
        && baru().diterima == request.time && stempel();
    }

    // Keputusan cek data (terima/tolak) per observasi. ID dokumen = id_observasi; keputusan terbaru yang berlaku.
    match /lbp_validasi/{id} {
      allow read: if bolehCekData();
      allow create, update: if bolehCekData()
        && baru().keys().hasOnly(['id_observasi', 'keputusan', 'alasan', 'validator', 'tanggal_validasi', 'oleh_uid', 'diperbarui'])
        && baru().id_observasi == id && id.size() <= 120
        && baru().keputusan in ['terima', 'tolak']
        && teksPendek(baru().alasan, 300) && teksPendek(baru().validator, 120) && teksPendek(baru().tanggal_validasi, 40)
        && stempel();
    }

    // Tindak lanjut peringatan. Setiap catatan dokumen baru, jadi riwayatnya utuh.
    match /lbp_tindak_lanjut/{id} {
      allow read: if bolehTindakLanjut();
      allow create: if bolehTindakLanjut()
        && baru().keys().hasOnly(['id_sinyal', 'status', 'catatan', 'petugas', 'tanggal', 'kode_varian', 'tanggal_kejadian', 'oleh_uid', 'diperbarui'])
        && baru().status in ['perlu_verifikasi', 'terverifikasi', 'false_alarm', 'ditindaklanjuti', 'selesai', 'anomali_terlewat']
        && teksPendek(baru().id_sinyal, 160) && teksPendek(baru().catatan, 500) && teksPendek(baru().petugas, 120)
        && teksPendek(baru().tanggal, 40) && teksPendek(baru().kode_varian, 30) && teksPendek(baru().tanggal_kejadian, 20)
        && (baru().status == 'anomali_terlewat' ? baru().kode_varian.size() > 0 : baru().id_sinyal.size() > 0)
        && stempel();
    }

    // Persetujuan model proyeksi per komoditas.
    match /lbp_persetujuan_model/{id} {
      allow read: if bolehSetujuiModel();
      allow create: if bolehSetujuiModel()
        && baru().keys().hasOnly(['kode_varian', 'model', 'keputusan', 'penyetuju', 'tanggal', 'catatan', 'oleh_uid', 'diperbarui'])
        && baru().keputusan in ['setuju', 'tolak']
        && teksPendek(baru().kode_varian, 30) && baru().kode_varian.size() > 0
        && teksPendek(baru().model, 60) && baru().model.size() > 0
        && teksPendek(baru().penyetuju, 120) && teksPendek(baru().tanggal, 40) && teksPendek(baru().catatan, 300)
        && stempel();
    }

    // Pengaturan sistem (isi config/pengaturan.json). "versi" naik satu setiap simpan, jadi dua admin yang menyimpan
    // bersamaan tidak saling menimpa: simpanan kedua ditolak dan perlu dimuat ulang.
    match /lbp_pengaturan/{id} {
      allow read: if aktif();
      allow create, update: if kelolaSistem() && id == 'utama'
        && baru().keys().hasOnly(['isi', 'versi', 'diubah_oleh', 'diubah_pada', 'ringkasan'])
        && baru().isi is map && baru().versi is int
        && baru().versi == (resource == null ? 1 : resource.data.versi + 1)
        && baru().diubah_oleh == request.auth.token.email
        && baru().diubah_pada == request.time
        && teksPendek(baru().ringkasan, 2000);
    }

    // Kunci rahasia: hanya bisa ditulis admin, tidak bisa dibaca dari browser siapa pun. Yang tampil di panel hanya
    // tanda "sudah diisi" di lbp_rahasia_status.
    match /lbp_rahasia/{nama} {
      allow read: if false;
      allow create, update: if kelolaSistem() && namaRahasiaSah(nama)
        && baru().keys().hasOnly(['nilai', 'diperbarui', 'oleh_uid'])
        && baru().nilai is string && baru().nilai.size() > 0 && baru().nilai.size() <= 8000
        && stempel();
      allow delete: if kelolaSistem();
    }
    match /lbp_rahasia_status/{nama} {
      allow read: if kelolaSistem();
      allow create, update: if kelolaSistem() && namaRahasiaSah(nama)
        && baru().keys().hasOnly(['diperbarui', 'oleh_uid', 'oleh_email'])
        && baru().oleh_email == request.auth.token.email
        && stempel();
      allow delete: if kelolaSistem();
    }

    // Permintaan "jalankan sekarang" dari panel Pengaturan. Satu dokumen per jenis; mesin mengambilnya lalu
    // mengisi status, waktu, dan alamat proses.
    match /lbp_perintah/{jenis} {
      allow read: if kelolaSistem();
      allow create, update: if kelolaSistem() && jenis in ['perbarui', 'cari_sumber']
        && baru().keys().hasOnly(['jenis', 'masukan', 'status', 'diminta_oleh', 'diminta_pada'])
        && baru().jenis == jenis && baru().masukan is map && baru().masukan.size() <= 10
        && baru().status == 'menunggu'
        && baru().diminta_oleh == request.auth.token.email
        && baru().diminta_pada == request.time;
    }

    // Status proses terakhir, ditulis mesin. Semua akun aktif boleh membaca.
    match /lbp_status/{id} {
      allow read: if aktif();
    }
  }
}
